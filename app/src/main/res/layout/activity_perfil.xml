<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:gravity="center"
            android:text="🎀"
            android:textSize="32sp"
            android:background="@drawable/bg_card_perfil"/>

        <TextView
            android:id="@+id/tituloPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Meu Perfil"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CorraMais"
            android:textColor="#FF80AB"
            android:textSize="14sp"
            android:layout_marginBottom="18dp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_perfil"
            android:orientation="vertical">


            <TextView
                android:id="@+id/txtNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 João Silva"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>


            <TextView
                android:id="@+id/txtTelefone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="📞 (42) 99999-9999"
                android:textColor="#DDDDDD"
                android:textSize="15sp"/>


            <TextView
                android:id="@+id/txtEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="✉ joao@email.com"
                android:textColor="#DDDDDD"
                android:textSize="15sp"/>

        </LinearLayout>


        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="100dp"
            android:layout_height="42dp"
            android:layout_marginTop="20dp"
            android:text="Voltar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#FF80AB"/>


    </LinearLayout>

</ScrollView>